{
  "name": "chai-aria-snapshot",
  "version": "1.0.0",
  "description": "Chai assertions for inline ARIA snapshots.",
  "homepage": "https://github.com/kcmr/chai-aria-snapshot#readme",
  "bugs": {
    "url": "https://github.com/kcmr/chai-aria-snapshot/issues"
  },
  "license": "MIT",
  "author": "Kus Cámara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kcmr/chai-aria-snapshot.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "rslib build --watch",
    "build": "rslib build",
    "release": "semantic-release",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p demos/snapshot-output/tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm test && pnpm lint && pnpm typecheck",
    "test": "pnpm build && web-test-runner --config web-test-runner.config.mjs",
    "browsers:install": "playwright install chromium firefox webkit",
    "demo:diff": "pnpm build && web-test-runner --config demos/snapshot-output/web-test-runner.config.mjs --files demos/snapshot-output/inline.test.ts",
    "demo:snapshots": "pnpm build && web-test-runner --config demos/snapshot-output/web-test-runner.config.mjs",
    "demo:snapshots:update": "pnpm demo:snapshots --update-snapshots"
  },
  "dependencies": {
    "@types/chai": "^5.2.3",
    "ivya": "^1.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@open-wc/testing": "^5.0.0",
    "@rslib/core": "^1.0.5",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-commands": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.0",
    "chai": "^6.3.0",
    "lefthook": "^2.2.2",
    "lit": "^3.3.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "chai": "^4.3.4 || ^6.3.0"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "@web/browser-logs>errorstacks": "2.4.1"
    },
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
