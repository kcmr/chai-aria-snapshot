{
  "name": "chai-aria-snapshot",
  "version": "0.0.0",
  "private": true,
  "description": "Chai assertions for inline ARIA snapshots powered by Ivya.",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@rslib/core": "1.0.5",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "rslib build --watch",
    "build": "rslib build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json"
  }
}
