{
  "name": "chai-aria-snapshot",
  "version": "0.0.0",
  "private": true,
  "description": "Chai assertions for inline ARIA snapshots powered by Ivya.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "rslib build --watch",
    "build": "rslib build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@rslib/core": "^1.0.5",
    "@types/node": "^22.20.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.14.0"
}
